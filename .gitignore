# ---------------------------------------------------------------------------
# Elder Link workspace — root ignore rules
# ---------------------------------------------------------------------------

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets — never commit these
.env
.env.*
.env.local
*.local
.dev.vars
!.env.example

# Agent / tooling state (contains session notes and, historically, secrets)
.workbuddy-ai/
.freebuff/

# Build output
dist/
dist-ssr/
build/
.output/
.vinxi/
.nitro/
.tanstack/
.build-verify/
.build-*/
.vercel/
**/.vercel/
.wrangler/

# Supabase CLI scratch
supabase/.temp/

# Test / build artefacts produced by scripts
e2e-shots/
