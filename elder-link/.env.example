# ---------------------------------------------------------------------------
# Elder Link — environment variables
# Copy to .env for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Browser-visible values (safe to expose):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-only values (NEVER expose to the browser):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Server scheduler / webhooks (required) --------------------------------
# Shared secret that protects POST /api/cron/tick (and other server routes).
CRON_SECRET=change-me-to-a-long-random-string

# --- Local demo mode (no Supabase account needed) --------------------------
# 1 = run the whole dashboard on an in-memory store with mock telephony.
# Also switches on automatically in a dev build when the Supabase values above
# are blank. A production build never falls back to demo data.
VITE_DEMO_MODE=

# --- Telephony (optional — mock is used when unset) ------------------------
# TELEPHONY_PROVIDER=mock | twilio
TELEPHONY_PROVIDER=mock

# Twilio account SID — starts with AC… (Console home → Account Info).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Preferred auth: an API Key (Console → Account → API keys & tokens).
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your-api-key-secret
# Alternative auth, and REQUIRED to verify Twilio's webhook signatures:
# TWILIO_AUTH_TOKEN=your-account-auth-token
# A Twilio number or verified caller ID you own, in E.164:
# TWILIO_FROM_NUMBER=+852xxxxxxxx
# Cantonese voice. <Say> fails when voice and language do not match, so set an
# explicit voice when using yue-HK (check Twilio's available-voices list):
# TWILIO_LANGUAGE=yue-HK
# TWILIO_VOICE=Google.yue-HK-Standard-A
# Optional: pre-generated Cantonese audio (free TTS tier) played instead of <Say>:
# TWILIO_AUDIO_URL=https://your-app.vercel.app/audio/checkin-yue.mp3
# Public URL of the webhook route (must be reachable by the provider):
# TELEPHONY_WEBHOOK_URL=https://your-app.vercel.app/api/telephony/events
# Shared secret for webhook callers that cannot sign (Twilio signs automatically):
# TELEPHONY_WEBHOOK_SECRET=another-long-random-string

# --- Staff sign-up allow-list (required for sign-up) -----------------------
# Comma-separated emails allowed to create a staff account.
ALLOWED_STAFF_EMAILS=you@example.org,teammate@example.org
